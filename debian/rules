#!/usr/bin/make -f

export PYBUILD_NAME=uwcc
export PYBUILD_SYSTEM=pyproject
export PYBUILD_DESTDIR=$(CURDIR)/debian/uwcc
export PYBUILD_TEST_PYTEST=1
export PYBUILD_TEST_ARGS=-q
export QT_QPA_PLATFORM=offscreen
export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
# Keep tests independent of the builder's personal settings and models.
export XDG_DATA_HOME=$(CURDIR)/debian/.test-data
export XDG_CACHE_HOME=$(CURDIR)/debian/.test-cache
export UWCC_MODEL_DIR=$(CURDIR)/debian/.test-models

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	desktop-file-validate data/*.desktop
	dh_auto_test

override_dh_python3:
# Explicit Debian dependencies replace PyPI names (notably PySide6 -> PyQt6).
	dh_python3 --no-guessing-deps
